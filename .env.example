# Copy this file to .env for local development.
# Never commit real credentials or secrets.

NODE_ENV=development
DATABASE_URL=postgresql://stationsnap:change-me@localhost:5432/stationsnap
LOG_LEVEL=info
# In production this must be set explicitly to the app's https:// origin — there is no
# localhost default once NODE_ENV=production (see src/lib/env.ts).
APP_URL=http://localhost:3000

# Required to deliver manager password-reset messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StationSnap <no-reply@example.com>

# Development seed secrets. Leave unset in production.
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_PIN=

# Media storage. "local" writes to disk at MEDIA_STORAGE_DIR (fine for local dev,
# does not persist on serverless hosts, and is rejected outright when NODE_ENV=production).
# "vercel-blob" requires BLOB_READ_WRITE_TOKEN from a Vercel Blob store attached to the
# project, and is required in production.
MEDIA_STORAGE_DIR=uploads
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
